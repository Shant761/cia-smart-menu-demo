rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function restaurantIsPublished(restaurantId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.published == true;
    }

    function isRestaurantAdmin(restaurantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)/admins/$(request.auth.uid)).data.active == true;
    }

    function validNameOverrides(data) {
      let names = data.get('nameOverrides', {});
      return names is map
        && names.keys().hasOnly(['hy', 'ru', 'en'])
        && names.get('hy', '') is string
        && names.get('ru', '') is string
        && names.get('en', '') is string;
    }

    function validIngredientNameOverrides(data) {
      return data.get('ingredientNameOverrides', {}) is map;
    }

    match /restaurants/{restaurantId} {
      allow read: if resource.data.published == true || isRestaurantAdmin(restaurantId);
      allow write: if false;

      match /admins/{adminUid} {
        allow read: if signedIn() && request.auth.uid == adminUid;
        allow write: if false;
      }

      match /categories/{categoryId} {
        allow read: if restaurantIsPublished(restaurantId) || isRestaurantAdmin(restaurantId);
        allow update: if isRestaurantAdmin(restaurantId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'smartMenuPublished',
            'restaurantReview',
            'updatedAt'
          ]);
        allow create, delete: if false;
      }

      match /products/{productId} {
        allow read: if restaurantIsPublished(restaurantId) || isRestaurantAdmin(restaurantId);
        // Only per-item Smart Menu overrides/review fields may be changed from Admin.
        // Poster recipe contents, quantities, prices and photos remain read-only.
        allow update: if isRestaurantAdmin(restaurantId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'smartMenuPublished',
            'restaurantReview',
            'allergens',
            'allergenReview',
            'allergenCustomization',
            'nameOverrides',
            'ingredientNameOverrides',
            'updatedAt'
          ])
          && validNameOverrides(request.resource.data)
          && validIngredientNameOverrides(request.resource.data);
        allow create, delete: if false;
      }

      match /product_analysis/{productId} {
        allow read: if isRestaurantAdmin(restaurantId);
        allow write: if false;
      }

      match /{privateDocument=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
