rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function restaurantIsPublished(restaurantId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.published == true;
    }

    function isRestaurantAdmin(restaurantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)/admins/$(request.auth.uid)).data.active == true;
    }

    function onlyMenuNameFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'smartMenuPublished',
        'restaurantReview',
        'allergens',
        'allergenReview',
        'allergenCustomization',
        'nameOverrides',
        'ingredientNameOverrides',
        'updatedAt'
      ]);
    }

    match /restaurants/{restaurantId} {
      allow read: if resource.data.published == true || isRestaurantAdmin(restaurantId);
      allow write: if false;

      match /admins/{adminUid} {
        allow read: if signedIn() && request.auth.uid == adminUid;
        allow write: if false;
      }

      match /categories/{categoryId} {
        allow read: if restaurantIsPublished(restaurantId) || isRestaurantAdmin(restaurantId);
        allow update: if isRestaurantAdmin(restaurantId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'smartMenuPublished',
            'restaurantReview',
            'updatedAt'
          ]);
        allow create, delete: if false;
      }

      match /products/{productId} {
        allow read: if restaurantIsPublished(restaurantId) || isRestaurantAdmin(restaurantId);

        // Poster source data remains read-only. Admin can change only Smart Menu
        // review/publication fields and the manual display-name overrides.
        allow update: if isRestaurantAdmin(restaurantId) && onlyMenuNameFieldsChanged();
        allow create, delete: if false;
      }

      match /product_analysis/{productId} {
        allow read: if isRestaurantAdmin(restaurantId);
        allow write: if false;
      }

      match /{privateDocument=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Deployment trigger: explicitly redeploy the current Firestore ruleset.
